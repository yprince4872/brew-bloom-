# Is file ko copy karke ".env" naam do aur apni values bharo

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/brewbloom?retryWrites=true&w=majority
JWT_SECRET=koi-lambi-random-string-yahan-daalo
ADMIN_PIN=ek-strong-pin-ya-password

# Razorpay dashboard > Account & Settings > API Keys (pehle Test keys se try karo)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Webhook secret (neeche steps dekho), optional lekin recommended
RAZORPAY_WEBHOOK_SECRET=koi-alag-lambi-string
CAFE_NAME=Brew & Bloom
PORT=3000
